<?xml version='1.0' encoding='utf-8'?>
<widget id="com.stark.jarvis" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>JARVIS</name>
    <description>Assistente JARVIS para Android</description>
    <author email="dev@stark.com" href="http://stark.com">Stark Industries</author>

    <content src="http://192.168.1.6:5000" />

    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="Fullscreen" value="true" />
    <preference name="AndroidInsecureFileModeEnabled" value="true" />

    <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application" xmlns:android="http://schemas.android.com/apk/res/android">
        <application android:usesCleartextTraffic="true" />
    </edit-config>
</widget>
